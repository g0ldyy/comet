<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content="Download the Comet add-on and repository for Kodi." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Comet for Kodi — Built to find it first" />
    <meta property="og:description" content="Download the Comet add-on and repository for Kodi." />
    <meta property="og:image" content="https://raw.githubusercontent.com/g0ldyy/comet/refs/heads/main/frontend/public/brand/comet-social-card.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Comet for Kodi — Built to find it first</title>
    <link rel="icon" href="repository.comet/icon.png" type="image/png" />
    <style>
      :root {
        color-scheme: dark;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --background: #090909;
        --surface: #111112;
        --surface-hover: #18181a;
        --border: rgb(244 241 236 / 10%);
        --border-strong: rgb(244 241 236 / 18%);
        --text: #f4f1ec;
        --muted: #aaa59e;
        --subtle: #77736e;
        --accent: #ff5a36;
        --accent-soft: rgb(255 90 54 / 12%);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        min-width: 20rem;
        background: var(--background);
      }

      body {
        min-height: 100dvh;
        margin: 0;
        display: grid;
        place-items: center;
        overflow-x: hidden;
        background: var(--background);
        color: var(--text);
      }

      .wake {
        position: fixed;
        inset: 0 0 0 auto;
        width: min(68rem, 72vw);
        height: 100%;
        pointer-events: none;
      }

      .wake__aura {
        filter: url(#aura);
        opacity: 0.38;
      }

      .wake__line,
      .wake__echo {
        fill: none;
        stroke-linecap: round;
      }

      .wake__line {
        stroke: var(--accent);
        stroke-width: 2;
      }

      .wake__echo {
        stroke: var(--text);
        stroke-width: 1;
        opacity: 0.08;
      }

      .shell {
        position: relative;
        width: min(100%, 48rem);
        padding: clamp(2rem, 7vw, 5rem) clamp(1.25rem, 6vw, 4rem);
        animation: enter 500ms cubic-bezier(0.22, 0.8, 0.22, 1) both;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: max-content;
        margin-bottom: clamp(3rem, 9vh, 6rem);
      }

      .brand img {
        width: 3rem;
        height: 3rem;
      }

      .brand__name {
        font-size: 1.35rem;
        font-weight: 720;
        letter-spacing: -0.03em;
      }

      h1 {
        max-width: 11ch;
        margin: 0;
        font-size: clamp(3rem, 8vw, 5rem);
        line-height: 0.98;
        letter-spacing: -0.06em;
      }

      .intro {
        max-width: 37rem;
        margin: 1.5rem 0 clamp(2.5rem, 7vh, 4rem);
        color: var(--muted);
        font-size: clamp(1rem, 2.4vw, 1.15rem);
        line-height: 1.65;
      }

      .downloads {
        border-block: 1px solid var(--border);
      }

      .download {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        min-height: 6rem;
        padding: 1.15rem 0.25rem;
        color: inherit;
        text-decoration: none;
        transition:
          background-color 140ms ease,
          border-color 140ms ease;
      }

      .download + .download {
        border-top: 1px solid var(--border);
      }

      .download:hover {
        background: var(--accent-soft);
      }

      .download:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }

      .download__title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.4rem;
        font-size: 1.05rem;
        font-weight: 680;
      }

      .download__recommended {
        padding: 0.25rem 0.5rem;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font-size: 0.65rem;
        font-weight: 750;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .download__description {
        color: var(--subtle);
        font-size: 0.85rem;
      }

      .download__version {
        flex: none;
        color: var(--muted);
        font-size: 0.78rem;
        font-variant-numeric: tabular-nums;
      }

      .instruction {
        margin: 1.5rem 0 0;
        color: var(--subtle);
        font-size: 0.8rem;
        line-height: 1.6;
      }

      .instruction strong {
        color: var(--muted);
        font-weight: 650;
      }

      @keyframes enter {
        from {
          opacity: 0;
          transform: translateY(0.75rem);
        }
      }

      @media (max-width: 36rem) {
        .wake {
          width: 100vw;
          opacity: 0.72;
        }

        .brand {
          margin-bottom: 3.5rem;
        }

        .download {
          min-height: 5.5rem;
        }

        .download__recommended {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .shell {
          animation: none;
        }

        .download {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <svg class="wake" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <filter id="aura" x="-40%" y="-40%" width="180%" height="180%" color-interpolation-filters="sRGB">
          <feGaussianBlur stdDeviation="22" />
        </filter>
      </defs>
      <path class="wake__aura" d="M610 1080C680 650 810 292 1040 44" fill="none" stroke="#ff5a36" stroke-width="38" />
      <path class="wake__line" d="M610 1080C680 650 810 292 1040 44" />
      <path class="wake__echo" d="M710 1080C765 710 872 392 1040 178" />
      <path class="wake__echo" d="M810 1080C850 774 925 500 1040 320" opacity=".55" />
    </svg>

    <main class="shell">
      <div class="brand">
        <img src="repository.comet/icon.png" alt="" />
        <span class="brand__name">Comet</span>
      </div>

      <h1>Built to find it first.</h1>
      <p class="intro">Choose automatic updates or a direct installation for Kodi.</p>

      <section class="downloads" aria-label="Downloads">
        <a href="REPO_URL" class="download">
          <span>
            <span class="download__title">
              Repository
              <span class="download__recommended">Recommended</span>
            </span>
            <span class="download__description">Automatic updates</span>
          </span>
          <span class="download__version">vV_REPO</span>
        </a>

        <a href="ADDON_URL" class="download">
          <span>
            <span class="download__title">Add-on</span>
            <span class="download__description">Direct installation</span>
          </span>
          <span class="download__version">vV_ADDON</span>
        </a>
      </section>

      <p class="instruction"><strong>In Kodi:</strong> Add-ons → Install from zip file</p>
    </main>
  </body>
</html>
